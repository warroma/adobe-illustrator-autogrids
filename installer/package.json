{
  "name": "autogrids-installer",
  "version": "1.1.1",
  "private": true,
  "description": "Instalador dos painéis AutoGrids e AutoPhysics para Adobe Illustrator (Windows/macOS)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/detect.test.js && node test/install.test.js && node test/panels.test.js && npm run test:panels",
    "test:panels": "node ../test/autophysics/physics.test.js && node ../test/autophysics/gif.test.js && node ../test/autophysics/bridge.test.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.autogrids.installer",
    "productName": "AutoGrids Installer",
    "icon": "build/icon.png",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      { "from": "../com.autogrids.panel", "to": "com.autogrids.panel" },
      { "from": "../com.autophysics.panel", "to": "com.autophysics.panel" }
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "category": "public.app-category.graphics-design",
      "artifactName": "AutoGrids-Instalador-macOS.${ext}"
    },
    "win": {
      "target": "portable",
      "artifactName": "AutoGrids-Instalador-Windows.${ext}"
    }
  }
}
